<meta preferred-color-scheme="light" />
<style>
  .icon { width: 34; height: 34; color: #FFFFFF; }
</style>
<div id="root" min-width="460" flex-direction="row" align-items="center" gap="18" padding-top="14" padding-bottom="14" padding-left="14" padding-right="30" border-radius="44" background-color="#FFFFFF" border-width="3" border-color="#E3E8EF">
  <div id="badge" width="64" height="64" border-radius="32" background-color="#011E41" align-items="center" justify-content="center">
    <Hand id="i-info" class="icon" />
    <TriangleAlert id="i-warn" class="icon" display="none" />
    <CircleCheck id="i-done" class="icon" display="none" />
    <Siren id="i-alert" class="icon" display="none" />
  </div>
  <div flex-direction="column" gap="2" flex-shrink="1">
    <p id="tag" font-size="17" font-weight="bold" color="#D92632" letter-spacing="2">AHORA</p>
    <p id="text" font-size="30" font-weight="bold" color="#011E41">Elige tu mesa</p>
  </div>
</div>