<meta preferred-color-scheme="light" />
<style>
  .row { flex-direction: row; align-items: center; gap: 14; padding-top: 10; padding-bottom: 10; padding-left: 10; padding-right: 14; border-radius: 22; background-color: #F4F6F9; }
  .chip { width: 46; height: 46; border-radius: 23; background-color: #011E41; align-items: center; justify-content: center; }
  .ricon { width: 24; height: 24; color: #FFFFFF; }
  .label { font-size: 22; font-weight: bold; color: #011E41; }
  .detail { font-size: 18; color: #5B6573; }
  .texts { flex-direction: column; gap: 2; flex-shrink: 1; }
</style>
<div id="root" width="440" flex-direction="column" gap="10" padding="20" border-radius="34" background-color="#FFFFFF" border-width="3" border-color="#E3E8EF">
  <div flex-direction="row" align-items="center" justify-content="space-between">
    <div flex-direction="row" align-items="center" gap="10">
      <div width="40" height="40" border-radius="20" background-color="#D92632" align-items="center" justify-content="center"><ListChecks width="22" height="22" color="#FFFFFF" /></div>
      <p font-size="28" font-weight="bold" color="#011E41">Por hacer</p>
    </div>
    <p id="progress" font-size="20" font-weight="bold" color="#D92632">0 de 8</p>
  </div>
  <div height="10" border-radius="5" background-color="#E9EDF2"><div id="bar" width="0%" height="10" border-radius="5" background-color="#1F8A4C" /></div>
  <div id="row0" class="row">
    <div id="chip0" class="chip">
      <Siren id="r0-urgent" class="ricon" display="none" /><Package id="r0-order" class="ricon" display="none" /><Users id="r0-line" class="ricon" display="none" /><ListChecks id="r0-sort" class="ricon" display="none" /><PackageOpen id="r0-boxes" class="ricon" display="none" /><TriangleAlert id="r0-out" class="ricon" display="none" />
    </div>
    <div class="texts"><p id="label0" class="label">-</p><p id="detail0" class="detail">-</p></div>
  </div>
  <div id="row1" class="row">
    <div id="chip1" class="chip">
