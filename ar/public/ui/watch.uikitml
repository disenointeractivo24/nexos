    </div>
    <div class="texts"><p id="label1" class="label">-</p><p id="detail1" class="detail">-</p></div>
  </div>
  <div id="row2" class="row">
    <div id="chip2" class="chip">
      <Siren id="r2-urgent" class="ricon" display="none" /><Package id="r2-order" class="ricon" display="none" /><Users id="r2-line" class="ricon" display="none" /><ListChecks id="r2-sort" class="ricon" display="none" /><PackageOpen id="r2-boxes" class="ricon" display="none" /><TriangleAlert id="r2-out" class="ricon" display="none" />
    </div>
    <div class="texts"><p id="label2" class="label">-</p><p id="detail2" class="detail">-</p></div>
  </div>
  <div id="row3" class="row">
    <div id="chip3" class="chip">
      <Siren id="r3-urgent" class="ricon" display="none" /><Package id="r3-order" class="ricon" display="none" /><Users id="r3-line" class="ricon" display="none" /><ListChecks id="r3-sort" class="ricon" display="none" /><PackageOpen id="r3-boxes" class="ricon" display="none" /><TriangleAlert id="r3-out" class="ricon" display="none" />
    </div>
    <div class="texts"><p id="label3" class="label">-</p><p id="detail3" class="detail">-</p></div>
